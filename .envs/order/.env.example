# Service Configuration
SERVICE_NAME=order-service

# Database Configuration
DATABASE_CONNECTION_URI=mongodb://mongo:mongo@mongo-service:27017/
DATABASE_NAME=order

# Server Configuration
GRPC_SERVER_PORT=50051

# Consul Configuration
CONSUL_ADDRESS=consul-service:8500

# RabbitMQ Configuration
RABBITMQ_ADDRESS=amqp://rabbitmq:rabbitmq@rabbitmq-service:5672/%2f

# Instance Configuration
INSTANCE_ID=8727ed1f-bd9e-4fe9-9978-3e20acac4601
INSTANCE_HOST=order-service
INSTANCE_PORT=50051
HEALTH_CHECK_URL=
HEALTH_CHECK_INTERVAL=10s

# Jaeger Configuration
OTLP_ENDPOINT=jaeger-service:4317
OTLP_PROTOCOL=grpc
OTLP_INSECURE=true

# Microservice Configuration
PRODUCT_SERVICE_NAME=product-service
INVENTORY_SERVICE_NAME=inventory-service
ORDER_SERVICE_NAME=order-service

# RabbitMQ Queues
ORDER_CREATED_QUEUE=order.order.created
ORDER_PENDING_CANCELLED_QUEUE=order.pending.cancelled
ORDER_PAID_SUCCESS_QUEUE=order.paid.success
ORDER_PAID_CANCELLED_QUEUE=order.paid.cancelled