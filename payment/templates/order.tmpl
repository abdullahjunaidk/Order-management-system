<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Complete Your Payment</title>
    </head>
    <body
        style="
            margin: 0;
            padding: 0;
            font-family: 'Courier New', Courier, monospace;
            line-height: 1.6;
            color: #333333;
        "
    >
        <table
            role="presentation"
            style="width: 100%; border-collapse: collapse"
        >
            <tr>
                <td
                    style="
                        padding: 40px 20px;
                        text-align: center;
                        background-color: #ffffff;
                    "
                >
                    <div style="max-width: 600px; margin: 0 auto">
                        <h1
                            style="
                                color: #2d3436;
                                margin-bottom: 20px;
                                font-size: 24px;
                            "
                        >
                            Hello {{.CustomerUsername}}!
                        </h1>
                        <p style="margin-bottom: 15px; font-size: 16px">
                            Your order #{{.OrderID}} is pending payment.
                        </p>
                        <p style="margin-bottom: 30px; font-size: 16px">
                            Please complete your payment to confirm your order:
                        </p>
                        <a
                            href="{{.PaymentLink}}"
                            style="
                                display: inline-block;
                                padding: 12px 24px;
                                background-color: #00b894;
                                color: #ffffff;
                                text-decoration: none;
                                border-radius: 4px;
                                font-weight: bold;
                            "
                            >Complete Payment</a
                        >
                        <p
                            style="
                                margin-top: 30px;
                                font-size: 14px;
                                color: #666666;
                            "
                        >
                            If you didn't place this order, please contact our support team immediately.
                        </p>
                    </div>
                </td>
            </tr>
        </table>
    </body>
</html>